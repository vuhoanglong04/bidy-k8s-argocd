// ==========================================
// Bidy Platform - Relational Database Schema
// Optimized for 3NF, Data Integrity, and Scale
// ==========================================

// ------------------------------------------
// 1. Core Entities
// ------------------------------------------

Table users {
  id bigint [primary key, increment, note: "Surrogate PK, BIGINT to avoid cap"]
  username varchar(50) [not null, unique]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, default: 'user', note: "user, admin. Platform wallet thuộc về một system-user role='admin' (username 'system_platform'), định danh qua env PLATFORM_WALLET_ID"]
  status varchar(20) [not null, default: 'active']
  account_locked boolean [not null, default: false]
  avatar_url varchar(1024) [note: "URI to object storage, avoid binary in DB"]
  created_at timestamptz [not null, default: `now()`, note: "TIMESTAMPTZ for timezone accuracy"]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    email
    username
    status
  }
}

// Ví là con số trong DB, KHÔNG phải tài khoản ngân hàng. Tiền thật của mọi user
// nằm chung trong một tài khoản ngân hàng duy nhất của admin; bảng này ghi ai sở
// hữu bao nhiêu trong đó. Sepay chỉ đọc biến động số dư tài khoản đó và bắn webhook,
// nó không giữ tiền và không phải cổng thanh toán. Xem docs/wallet-plan.md mục 0.1.
Table wallets {
  id bigint [primary key, increment]
  user_id bigint [not null, unique, ref: > users.id]
  balance decimal(14,2) [not null, default: 0, note: "Cached balance, nguồn sự thật thật sự là SUM(wallet_ledger.amount)"]
  status varchar(20) [not null, default: 'active', note: "active, locked (khi có tranh chấp/gian lận)"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table wallet_ledger {
  id bigint [primary key, increment]
  wallet_id bigint [not null, ref: > wallets.id]
  type varchar(30) [not null, note: "topup_success, payment, payment_escrow_in, payment_release, payment_escrow_out, platform_fee, payment_refund, withdraw_hold, withdraw_success, withdraw_failed, withdraw_cancelled, adjustment"]
  amount decimal(14,2) [not null, note: "Số có dấu: dương = cộng tiền, âm = trừ tiền. SUM toàn bảng luôn = 0 (double-entry)"]
  balance_after decimal(14,2) [not null, note: "Snapshot số dư sau bút toán này, phục vụ đối soát"]
  reference_type varchar(30) [note: "sepay_webhook, order, auction_deposit, withdrawal_request"]
  reference_id bigint [note: "Polymorphic FK trỏ tới bản ghi liên quan"]
  idempotency_key varchar(255) [unique, not null, note: "Format {type}:{reference_id}, vd order_payment:1024. Chặn xử lý trùng ở tầng constraint"]
  metadata jsonb [note: "Payload phụ: admin_id thao tác, lý do adjustment, fee_rate áp dụng"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    wallet_id
    (reference_type, reference_id)
    (wallet_id, created_at) [note: "Cursor pagination lịch sử giao dịch"]
  }
}

// Yêu cầu rút tiền. Admin xử lý thủ công, chuyển khoản ngoài hệ thống rồi
// upload biên lai. Ví bị trừ ngay lúc tạo request (withdraw_hold) để tiền
// không bị tiêu trùng, hoàn lại khi reject/cancel.
Table wallet_withdrawal_requests {
  id bigint [primary key, increment]
  wallet_id bigint [not null, ref: > wallets.id]
  user_id bigint [not null, ref: > users.id, note: "Denormalized, khỏi join wallets"]
  amount decimal(14,2) [not null, note: "Chuyển đủ 100%. Phí đã thu tại thời điểm release. Không có hạn mức min/max"]
  bank_account_no varchar(50) [not null]
  bank_account_name varchar(255) [not null]
  bank_code varchar(20) [not null]
  status varchar(20) [not null, default: 'pending', note: "pending, processing, completed, rejected, cancelled"]
  cancelled_by varchar(20) [note: "user | admin. NULL nếu chưa đóng"]
  deadline_at timestamptz [not null, note: "= created_at + 10 ngày (SLA). Quá hạn chỉ cảnh báo admin, không tự hoàn tiền"]
  admin_id bigint [ref: > users.id, note: "Admin thao tác. Không phải người sở hữu tiền"]
  proof_url varchar(1024) [note: "Biên lai admin chuyển khoản tay từ app ngân hàng. Bắt buộc khi complete — không có lệnh chi tự động"]
  reject_reason text
  processed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    wallet_id
    user_id
    status
    deadline_at
    (user_id) [unique, note: "PARTIAL INDEX: WHERE status IN ('pending','processing'). Mỗi user chỉ một request rút đang mở — chặn ở tầng DB thay vì service"]
  }
}

// Tổng hợp hằng đêm cho dashboard admin, tránh quét full ledger mỗi lần đọc.
Table wallet_daily_summary {
  id bigint [primary key, increment]
  summary_date date [not null]
  total_topup decimal(14,2) [not null, default: 0]
  total_payment decimal(14,2) [not null, default: 0]
  total_withdraw decimal(14,2) [not null, default: 0]
  total_platform_fee decimal(14,2) [not null, default: 0]
  active_wallets int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    summary_date [unique]
  }
}

Table addresses {
  id bigint [primary key, increment]
  user_id bigint [not null, ref: > users.id]
  street varchar(255) [not null]
  city varchar(100) [not null]
  state varchar(100) [not null]
  zip_code varchar(20)
  is_default boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
  }
}

Table categories {
  id bigint [primary key, increment]
  parent_id bigint [ref: > categories.id, note: "Nullable for top-level categories"]
  name varchar(100) [not null, unique]
  image_url varchar(1024)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    parent_id
  }
}

// ------------------------------------------
// 2. Products Catalog
// ------------------------------------------

Table products {
  id bigint [primary key, increment]
  owner_id bigint [not null, ref: > users.id]
  category_id bigint [not null, ref: > categories.id]
  name varchar(255) [not null]
  description text [not null, default: '']
  condition varchar(50) [not null, default: 'new', note: "e.g., new, used, refurbished"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    owner_id
    category_id
  }
}

Table product_images {
  id bigint [primary key, increment]
  product_id bigint [not null, ref: > products.id]
  image_url varchar(1024) [not null]
  is_primary boolean [not null, default: false]
  display_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    product_id
  }
}

// ------------------------------------------
// 3. Operational/Auction Data (OLTP)
// ------------------------------------------

Table auctions {
  id bigint [primary key, increment]
  product_id bigint [not null, ref: > products.id]
  starting_price decimal(14, 2) [not null]
  current_price decimal(14, 2) [not null, default: 0]
  buy_now_price decimal(14, 2) [note: "Nullable. NULL means no buy-now option"]
  reserve_price decimal(14, 2) [note: "Nullable. Minimum price to actually sell"]
  bid_increment decimal(14, 2) [not null, default: 1.00, note: "Minimum amount per bid jump. Single source of truth for the step size — manual AND proxy bids advance by this, so auto-bid resolution is deterministic"]
  status varchar(30) [not null, default: 'pending', note: "pending, happening, ended, cancelled"]
  has_active_auto_bid boolean [not null, default: false, note: "Denormalized cache of `EXISTS(auto_bid_configs WHERE auction_id = id AND is_active)`. Lets list/detail endpoints render the auto-bid badge without a join. Source of truth stays auto_bid_configs"]
  start_date timestamptz [not null]
  end_date timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    product_id
    status
    (start_date, end_date)
  }
}

Table bid_history {
  id bigint [primary key, increment]
  auction_id bigint [not null, ref: > auctions.id]
  user_id bigint [not null, ref: > users.id]
  amount decimal(14, 2) [not null]
  action_type varchar(30) [not null, default: 'place_bid', note: "place_bid | auto_bid | outbid | won | lost | buy_now. Free-form varchar so a new event type never needs a migration"]
  position int [note: "Rank of this user at the moment the row was written (1 = leading). Nullable for events where rank is meaningless"]
  metadata jsonb [note: "Event-specific payload. For auto_bid: { auto_bid_config_id, triggered_by_bid_id, limit_bid }. Keeps the proxy-bid audit trail without widening the table per event type"]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    auction_id
    user_id
  }
}

// Proxy (auto) bidding. One row = "bid for me up to limit_bid on this auction".
// When any bid lands, the engine finds the highest active config that can still
// outbid it and posts a bid of (challenger + auctions.bid_increment), capped at
// limit_bid — resolved inside the same transaction that holds the auction row lock.
Table auto_bid_configs {
  id bigint [primary key, increment]
  auction_id bigint [not null, ref: > auctions.id]
  user_id bigint [not null, ref: > users.id]
  limit_bid decimal(14, 2) [not null, note: "Ceiling the engine may bid up to on this user's behalf. Never revealed to other bidders"]
  is_active boolean [not null, default: true, note: "User can pause proxy bidding without losing the ceiling. Also flipped off by the engine once limit_bid can no longer beat the leader"]
  created_at timestamptz [not null, default: `now()`, note: "Tie-break: on equal limit_bid the earlier config wins (standard proxy-auction rule)"]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (auction_id, user_id) [unique, note: "One config per user per auction — re-arming auto-bid UPSERTs this row"]
    (auction_id, limit_bid, created_at) [note: "Partial index in Postgres: WHERE is_active. Resolves 'highest active competitor' in one index scan instead of a full-table filter as auto_bid_configs grows"]
  }
}

// CHƯA ĐƯỢC SỬ DỤNG: bảng đã tồn tại nhưng không service nào đọc/ghi.
// Việc nối tiền cọc vào ví nằm ở Phase 8 của docs/wallet-plan.md, chờ chốt nghiệp vụ.
Table auction_deposits {
  id bigint [primary key, increment]
  auction_id bigint [not null, ref: > auctions.id]
  user_id bigint [not null, ref: > users.id]
  amount decimal(14, 2) [not null]
  status varchar(30) [not null, default: 'held', note: "held, refunded, forfeited"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    auction_id
    user_id
  }
}

// ------------------------------------------
// 4. E-Commerce & Transactions
// ------------------------------------------

Table wishlists {
  id bigint [primary key, increment]
  user_id bigint [not null, ref: > users.id]
  auction_id bigint [not null, ref: > auctions.id]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, auction_id) [unique]
  }
}

Table orders {
  id bigint [primary key, increment]
  buyer_id bigint [not null, ref: > users.id]
  seller_id bigint [not null, ref: > users.id, note: "Denormalized for fast seller reporting"]
  auction_id bigint [not null, ref: > auctions.id]
  shipping_address_id bigint [not null, ref: > addresses.id]

  final_price decimal(14, 2) [not null]
  shipping_fee decimal(14, 2) [not null, default: 0]
  total_amount decimal(14, 2) [not null, note: "final_price + shipping_fee"]

  payment_status varchar(30) [not null, default: 'pending', note: "pending, paid, expired, refunded"]
  shipping_status varchar(30) [not null, default: 'pending', note: "pending, processing, shipped, delivered, returned"]
  tracking_number varchar(100)

  // Escrow: tiền buyer trả nằm ở platform wallet cho tới khi release cho seller.
  // payment_status nói buyer đã trả chưa; fund_status nói tiền đó hiện ở đâu.
  fund_status varchar(20) [not null, default: 'none', note: "none, held, released, refunded. 'released' là trạng thái cuối: không có refund/clawback sau release"]
  payment_channel varchar(20) [note: "wallet | qr_direct. Trả bằng số dư ví hay quét QR trả thẳng"]
  platform_fee decimal(14,2) [note: "Snapshot hoa hồng = ROUND(final_price * fee_rate, 2). Tính trên final_price, KHÔNG gồm shipping_fee"]
  seller_payout decimal(14,2) [note: "Snapshot final_price + shipping_fee - platform_fee"]
  fee_rate decimal(5,4) [note: "Snapshot tỷ lệ áp dụng (0.0500), giữ lại phòng khi đổi chính sách phí"]

  payment_deadline timestamptz [not null]
  delivered_at timestamptz [note: "Set khi shipping_status -> delivered. FE dùng để cảnh báo đơn đã giao lâu mà chưa release. KHÔNG có auto-release"]
  released_at timestamptz
  released_by bigint [ref: > users.id, note: "Admin bấm release. Luôn có giá trị — release chỉ chạy thủ công"]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    buyer_id
    seller_id
    auction_id
    payment_status
    shipping_status
    fund_status
  }
}

Table transactions {
  id bigint [primary key, increment]
  order_id bigint [ref: > orders.id, note: "Nullable: giao dịch nạp ví không gắn với order nào"]
  wallet_id bigint [ref: > wallets.id, note: "Ví nhận/trả tiền của giao dịch này"]
  user_id bigint [not null, ref: > users.id]
  amount decimal(14, 2) [not null]
  payment_method varchar(50) [not null, note: "Giá trị đang dùng: 'sepay'. Đúng bản chất là chuyển khoản ngân hàng, Sepay chỉ là nguồn thông báo biến động"]
  provider_transaction_id varchar(255) [unique, note: "ID từ cổng thanh toán. Unique để chặn webhook ghi trùng ở tầng DB"]
  transaction_status varchar(30) [not null, default: 'pending']
  transaction_date timestamptz [not null, default: `now()`]

  Indexes {
    order_id
    user_id
    wallet_id
  }
}


// ------------------------------------------
// 5. Communication & Support
// ------------------------------------------

Table notifications {
  id bigint [primary key, increment]
  recipient_id bigint [not null, ref: > users.id]
  actor_id bigint [ref: > users.id, note: "Nullable. NULL = System"]
  title varchar(255) [not null]
  message text [not null]
  type varchar(50) [not null]
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    recipient_id
    is_read
  }
}

Table support_tickets {
  id bigint [primary key, increment]
  user_id bigint [not null, ref: > users.id]
  admin_id bigint [ref: > users.id, note: "Nullable. NULL = Unassigned"]
  subject varchar(255) [not null]
  status varchar(30) [not null, default: 'open']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
    admin_id
    status
  }
}

Table support_messages {
  id bigint [primary key, increment]
  ticket_id bigint [not null, ref: > support_tickets.id]
  sender_id bigint [not null, ref: > users.id]
  content text [not null]
  message_type varchar(20) [not null, default: 'text']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    ticket_id
  }
}

Table conversations {
  id bigint [primary key, increment]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table conversation_members {
  conversation_id bigint [not null, ref: > conversations.id]
  user_id bigint [not null, ref: > users.id]
  joined_at timestamptz [not null, default: `now()`]

  Indexes {
    (conversation_id, user_id) [unique]
    user_id
  }
}

Table messages {
  id bigint [primary key, increment]
  conversation_id bigint [not null, ref: > conversations.id]
  sender_id bigint [not null, ref: > users.id]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    conversation_id
  }
}

// ------------------------------------------
// 6. Reviews & Ratings
// ------------------------------------------

Table reviews {
  id bigint [primary key, increment]
  order_id bigint [not null, ref: - orders.id, note: "One-to-One: 1 order can only have 1 review"]
  reviewer_id bigint [not null, ref: > users.id]
  reviewee_id bigint [not null, ref: > users.id, note: "Denormalized from order.seller_id for fast queries"]
  
  product_rating int [not null, note: "1-5 stars. Use CHECK(product_rating BETWEEN 1 AND 5)"]
  shipping_rating int [note: "Nullable if not rated"]
  service_rating int [note: "Nullable if not rated"]
  
  comment text
  is_anonymous boolean [not null, default: false]
  status varchar(20) [not null, default: 'published']
  
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    order_id [unique, note: "Ensures no duplicate reviews for an order"]
    reviewee_id
    status
  }
}

Table review_media {
  id bigint [primary key, increment]
  review_id bigint [not null, ref: > reviews.id]
  media_url varchar(1024) [not null]
  media_type varchar(20) [not null, default: 'image']
  display_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    review_id
  }
}

Table review_replies {
  id bigint [primary key, increment]
  review_id bigint [not null, ref: - reviews.id, note: "One-to-One if seller only replies once"]
  user_id bigint [not null, ref: > users.id]
  comment text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    review_id [unique, note: "Prevents seller from spamming replies to 1 review"]
  }
}

// ------------------------------------------
// 7. Analytical / Historical Data (OLAP)
// ------------------------------------------

Table archive_bid_history {
  id bigint [primary key]
  auction_id bigint [not null]
  user_id bigint [not null]
  amount decimal(14, 2) [not null]
  action_type varchar(30) [not null]
  created_at timestamptz [not null]
  archived_at timestamptz [not null, default: `now()`]
  
  note: "Data warehouse table. Deep reports hit here to save OLTP performance."
}
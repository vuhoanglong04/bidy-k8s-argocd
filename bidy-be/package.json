{
  "name": "auction-be",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx ./src/server.ts",
    "build": "tsc",
    "dev": "tsx watch ./src/server.ts",
    "json-sv": "json-server --watch db.json --port 8001",
    "test": "tsx ./src/tests/run-checks.ts",
    "index": "npx gitnexus analyze",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "migrate": "tsx ./src/common/scripts/run-migrations.ts",
    "seed": "tsx ./src/database/seeds/index.ts",
    "seed:order": "tsx ./src/database/seeds/order.seed.ts",
    "migrate:status": "tsx ./node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "migrate:rollback": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "openapi:export": "tsx ./src/common/scripts/export-openapi.ts",
    "sepay:simulate": "tsx ./src/common/scripts/simulate-sepay.ts",
    "wallet:reconcile": "tsx ./src/common/scripts/run-reconciliation.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "joi": "^18.0.0",
    "json-server": "^1.0.0-beta.3",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.0.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "nodemon": "^3.0.2",
    "pg": "^8.22.0",
    "rate-limit-redis": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.7.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}

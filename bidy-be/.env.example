# Environment Configuration
# Drives log verbosity and TypeORM/error verbosity: 'development' | 'production'
NODE_ENV=development

# Database Configuration (PostgreSQL) — REQUIRED
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bidy_db

# Redis — REQUIRED
# Not just a cache: refresh tokens, email-verification and password-reset tokens all
# live here, so authentication is broken without a reachable Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
# Required by docker-compose (redis runs with --requirepass); use a long random value.
REDIS_PASSWORD=

# pgAdmin — required by docker-compose; bound to 127.0.0.1:5050, reach it via SSH tunnel.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# JWT Configuration — BOTH SECRETS REQUIRED
# The app throws at startup if either is missing (Joi schema in auth.service.ts).
# They must be two different values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_for_security
JWT_REFRESH_SECRET=a_second_and_different_secret_at_least_32_characters

# Optional token lifetimes (defaults shown)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_TTL_SECONDS=604800
# Window where the previous refresh token is still accepted, for in-flight requests
JWT_REFRESH_GRACE_SECONDS=30
VERIFY_TOKEN_TTL_SECONDS=900
RESET_TOKEN_TTL_SECONDS=900

# Password hashing (optional, default 12)
BCRYPT_SALT_ROUNDS=12

# Cloudflare R2 Configuration — REQUIRED for file uploads
# R2_ENDPOINT is the account-level S3 API endpoint; do NOT append the bucket name.
ACCESS_KEY_ID=your_r2_access_key_id
SECRET_ACCESS_KEY=your_r2_secret_access_key
BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# The bucket must stay PRIVATE: images are served through short-lived presigned URLs,
# so no public domain is configured and none should be enabled.

# SePay Payment Gateway Configuration
# Webhook endpoint to register in the SePay dashboard:
#   POST https://<your-public-domain>/api/v1/orders/webhook/sepay
# Set AT LEAST ONE of SEPAY_WEBHOOK_SECRET / SEPAY_API_KEY. With neither, the webhook
# accepts UNAUTHENTICATED requests and only logs a warning — never deploy that way.
# HMAC (webhook secret) takes precedence when both are set.
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=1017588888
SEPAY_ACCOUNT_NAME=CONG TY BIDY
SEPAY_PAYMENT_PREFIX=BIDY
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret_key
SEPAY_API_KEY=your_sepay_api_key

# Email Configuration (Required for email notifications)
# MAIL_PASSWORD is a Gmail App Password, not the account password.
MAIL_FROM=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# Admin Configuration
# ADMIN_EMAIL / ADMIN_PASSWORD: credentials for the account `npm run seed` creates.
ADMIN_EMAIL=admin@bidy.local
ADMIN_PASSWORD=Password123!
# Users row id (users.id, a bigint) that receives support-chat conversations.
# The seed logs the id to set here after it creates (or finds) the admin account.
ID_ADMIN=

# Pagination Configuration
# Fallback page size when a request omits `limit`.
LIMIT_NUMBER=100

# Client URL Configuration
# Base URL used to build email verification and password reset links.
# Development: http://localhost:3000
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:3000

# Server Configuration
PORT=8000
# Comma-separated CORS allowlist. When unset, falls back to localhost:3000,
# 127.0.0.1:3001 and CLIENT_URL. Set it explicitly in production.
ALLOWED_ORIGINS=http://localhost:3000

# Logging Configuration
# Enables TypeORM SQL query logging.
DEBUG=false

# Wallet Configuration
# Wallet row that collects platform fees.
PLATFORM_WALLET_ID=1
